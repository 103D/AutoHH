"# Database
DATABASE_URL=postgresql+asyncpg://jobhunter:password@localhost:5432/jobhunter

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider
AI_PROVIDER=openai  # openai | openrouter
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Job Fetching
JOB_FETCH_INTERVAL_MINUTES=30
JOB_CLEANUP_DAYS=90

# Scoring Weights
SCORE_WEIGHT_SEMANTIC=0.4
SCORE_WEIGHT_TECHNICAL=0.3
SCORE_WEIGHT_EXPERIENCE=0.2
SCORE_WEIGHT_OTHER=0.1

# Recommendation Thresholds
THRESHOLD_HIGH_PRIORITY=90
THRESHOLD_APPLY=75
THRESHOLD_REVIEW=60

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO"