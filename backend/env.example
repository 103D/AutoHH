# Database
DATABASE_URL=postgresql+asyncpg://jobhunter:password@localhost:5432/jobhunter

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider
# OmniRoute (https://github.com/diegosouzapw/OmniRoute) is an OpenAI-compatible
# local AI gateway. When running inside the AtoHH Docker network, point the
# backend at the `omniroute` service. If you run OmniRoute on the host instead,
# use http://host.docker.internal:20128/v1.
#
# Pick any model exposed by `/v1/models`
# (e.g. opencode-zen/hy3-free, oc/hy3-free, kilocode/anthropic/claude-sonnet-4.6).
AI_PROVIDER=openai
AI_BASE_URL=http://omniroute:20128/v1
AI_API_KEY=sk-your-omniroute-key
AI_MODEL=opencode-zen/hy3-free
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# OpenRouter (optional) — direct OpenRouter path, used as a fallback when
# AI_BASE_URL is empty and the primary AI fails. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=opencode-zen/hy3-free

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: webhook secret token (pass to setWebhook as secret_token; the
# backend then rejects requests without the matching
# X-Telegram-Bot-Api-Secret-Token header).
TELEGRAM_WEBHOOK_SECRET=

# Job Fetching
JOB_FETCH_INTERVAL_MINUTES=30
JOB_CLEANUP_DAYS=90

# Scoring Weights — deterministic components (normalized to 1.0)
# NOTE: SCORE_WEIGHT_SEMANTIC is deprecated — the LLM no longer blends into the
# final score (match model v3); it only supplies semantic interpretation.
SCORE_WEIGHT_SEMANTIC=0.4
SCORE_WEIGHT_TECHNICAL=0.30
SCORE_WEIGHT_EXPERIENCE=0.20
SCORE_WEIGHT_LOCATION=0.10
SCORE_WEIGHT_SALARY=0.10
SCORE_WEIGHT_WORK_FORMAT=0.10
SCORE_WEIGHT_EDUCATION=0.10
SCORE_WEIGHT_LANGUAGE=0.10

# Skill importance weights inside the technical component (match model v3).
# REQUIRED skills dominate: their absence visibly lowers the technical score.
SCORE_REQUIRED_SKILL_WEIGHT=3.0
SCORE_PREFERRED_SKILL_WEIGHT=1.5
SCORE_OPTIONAL_SKILL_WEIGHT=0.5
# Soft cap per missing REQUIRED skill: final score <= 100 - N * penalty.
# A missing mandatory skill is always visible but is NOT a hard blocker.
SCORE_MISSING_REQUIRED_PENALTY=25.0

# Hard requirements: any critical failure => NOT_ELIGIBLE
HARD_FILTERS_ENABLED=true
# Business rule: a vacancy may require at most HARD_EXPERIENCE_MAX_FACTOR x the
# candidate's experience, but the candidate always gets an absolute buffer of
# HARD_EXPERIENCE_MAX_GAP years. Effective allowance = max(years*factor,
# years+gap). The gap keeps a 0-year junior eligible for entry ("1+") roles.
HARD_EXPERIENCE_MAX_FACTOR=1.5
HARD_EXPERIENCE_MAX_GAP=2.0
HARD_SALARY_TOLERANCE=0.20

# LLM cost gate: skip AI analysis when deterministic score is below this
LLM_GATE_ENABLED=true
LLM_GATE_MIN_DETERMINISTIC_SCORE=40

# Feedback loop: match-score buckets for outcome analytics
FEEDBACK_SCORE_BUCKETS=40,55,70,85

# Match category thresholds (matching v2)
THRESHOLD_DREAM_JOB=85
THRESHOLD_STRETCH=70
THRESHOLD_SOLID_MATCH=55
THRESHOLD_MARKET_RESEARCH=40
THRESHOLD_LEARNING=25

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO

# HeadHunter API User-Agent (required by api.hh.ru; otherwise 403/400)
# You MUST register an application at https://dev.hh.ru/ to get a valid
# App ID and use it in the User-Agent. Free/public UAs and common email
# domains (gmail.com, mail.ru, example.com) are blacklisted by HH.
# Format: "AppName/Version (contact@yourdomain.com)"
HH_USER_AGENT=JobHunter/0.1.0 (contact@yourdomain.com)

# HeadHunter OAuth — applicant account integration (ADR-001).
# Register your application at https://dev.hh.ru/; the redirect URI must
# match the registered value exactly.
# HH_OAUTH_CLIENT_ID=your-app-id
# HH_OAUTH_CLIENT_SECRET=your-app-secret
# HH_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/hh/oauth/callback
# PKCE S256: enable ONLY if your HH app is registered with PKCE support.
# HH_OAUTH_USE_PKCE=false
# Dedicated Fernet key for encrypting HH tokens at rest (MUST differ from
# SECRET_KEY). Generate once per environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HH_CREDENTIALS_KEY=
# Background HH sync workers (ADR-001 M6): periodic read-only sync of
# connected applicant accounts and a Redis-backed token-refresh lock.
HH_SYNC_INTERVAL_MINUTES=15
HH_SYNC_BATCH_SIZE=100
HH_REFRESH_LOCK_TTL_SECONDS=60
# Interim ownership boundary until real auth (ADR-001 production gate):
# a fixed local user id all HH-account queries are scoped by.
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# LLM result cache (Redis): reuse previous AI analyses — same vacancy +
# candidate skills + prompt version => no repeated LLM cost (spec #28)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_HOURS=168

# Prompt version stored with analyses and used in LLM cache keys (specs #10/#28)
PROMPT_VERSION=v1

# Prometheus metrics: /metrics endpoint + pipeline counters (spec #22)
METRICS_ENABLED=true

# Threshold advisor: applications per score bucket before suggestions stop
# being marked as provisional (spec #18)
THRESHOLD_ADVISOR_MIN_BUCKET=5
