# Copy to .env.production and replace every placeholder before deployment.
# Never commit .env.production.

POSTGRES_USER=jobhunter
POSTGRES_DB=jobhunter
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# Service hostnames must remain postgres/redis inside the Compose network.
DATABASE_URL=postgresql+asyncpg://jobhunter:replace-with-url-encoded-password@postgres:5432/jobhunter
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0

SECRET_KEY=replace-with-at-least-32-random-bytes
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EXTRA_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

HH_USER_AGENT=AutoHH/1.0 (api-contact@your-domain.example)

# HeadHunter OAuth applicant-account integration (ADR-001). Register at
# https://dev.hh.ru/; redirect URI must match the registered value.
# HH_OAUTH_CLIENT_ID=
# HH_OAUTH_CLIENT_SECRET=
# HH_OAUTH_REDIRECT_URI=https://your-domain.example/api/v1/hh/oauth/callback
# Fernet key for HH token encryption at rest — MUST differ from SECRET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HH_CREDENTIALS_KEY=
# Background HH sync workers (ADR-001 M6). Requires REDIS_URL for both Celery
# broker/backend and distributed refresh locks.
HH_SYNC_INTERVAL_MINUTES=15
HH_SYNC_BATCH_SIZE=100
HH_REFRESH_LOCK_TTL_SECONDS=60

# Bind only the public reverse-proxy port on the host.
AUTOHH_HTTP_PORT=80