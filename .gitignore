# Hermes Agent (local sessions/cache only)
# NOTE: use `.hermes/*` + negations, not `.hermes/` — git cannot
# re-include files inside an ignored directory.
.hermes/*
!.hermes/project.yaml
!.hermes/INTEGRATION.md